{
  "expo": {
    "name": "GoswamiShaadi",
    "slug": "goswami-shaadi",
    "version": "1.5.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "goswamishaadi",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8FA",
    "ios": {
      "bundleIdentifier": "com.goswami.shaadi",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Goswami Shaadi uses the microphone for voice calls with your matches.",
        "NSCameraUsageDescription": "Goswami Shaadi uses the camera for video calls with your matches."
      }
    },
    "android": {
      "package": "com.goswami.shaadi",
      "adaptiveIcon": {
        "backgroundColor": "#D92F4B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D92F4B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "GoswamiShaadi needs access to your photos so you can add them to your profile.",
          "cameraPermission": "Goswami Shaadi uses the camera for video calls and profile photos."
        }
      ],
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#7C3AED"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "00cffee8-4e3c-4508-bbd0-3639a9685715"
      }
    },
    "owner": "ahesanchowdhury",
    "updates": {
      "url": "https://u.expo.dev/00cffee8-4e3c-4508-bbd0-3639a9685715"
    }
  }
}
